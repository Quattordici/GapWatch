<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>GapWatch.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit.Core" />
    <PackageReference Include="TUnit.Engine" />
    <PackageReference Include="TUnit.Mocks" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GapWatch.Core\GapWatch.Core.csproj" />
    <ProjectReference Include="..\..\src\GapWatch.OpenApi\GapWatch.OpenApi.csproj" />
    <ProjectReference Include="..\..\src\GapWatch.Reporting\GapWatch.Reporting.csproj" />
    <ProjectReference Include="..\..\src\GapWatch.Roslyn\GapWatch.Roslyn.csproj" />
    <ProjectReference Include="..\..\src\GapWatch.Cli\GapWatch.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The C# fixture API is test input, not part of the test assembly. -->
    <Compile Remove="Fixtures\**" />
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Golden\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
